{
  "name": "jarvis-desktop",
  "productName": "JARVIS",
  "version": "1.1.0",
  "description": "JARVIS - Agentic AI operating layer for your laptop",
  "main": "main.js",
  "author": {
    "name": "JARVIS Owner",
    "email": "jarvis@localhost"
  },
  "license": "MIT",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "node -e \"console.log('Build complete')\""
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {},
  "build": {
    "appId": "com.jarvis.desktop",
    "productName": "JARVIS",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/bindings/**",
      "node_modules/file-uri-to-path/**"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "renderer/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JARVIS"
    },
    "publish": {
      "provider": "github",
      "owner": "ahsanmarketer6-afk",
      "repo": "jarvis-desktop",
      "releaseType": "release"
    }
  }
}
